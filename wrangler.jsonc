{
    "name": "mu",
    "compatibility_date": "2026-03-05",
    "pages_build_output_dir": "dist",
    "r2_buckets": [{
        "bucket_name": "repo",
        "binding": "REPO"
    }],
    "d1_databases": [{
        "binding": "DB",
        "database_name": "muoft",
        "database_id": "TODO: id from `npx wrangler d1 create muoft` in the muoft Cloudflare account",
        "migrations_dir": "migrations"
    }]
}
